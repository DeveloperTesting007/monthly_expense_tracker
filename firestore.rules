rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Common functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.admin == true || request.auth.uid == "ADMIN_UID";
    }

    // User-specific collections
    match /monthly_tracker/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update, delete: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if isAdmin();
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update, delete: if isAuthenticated() && isOwner(userId);
      }

      // Todos subcollection
      match /todos/{todoId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update, delete: if isAuthenticated() && isOwner(userId);
      }

      match /monthly_tracker/{userId}/todos/{todoId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() 
          && isOwner(userId)
          && validTodo(request.resource.data);
        allow update: if isAuthenticated() 
          && isOwner(userId)
          && validTodoUpdate(request.resource.data);
        allow delete: if isAuthenticated() 
          && isOwner(userId);
      }
    }

    // Users collection - User-specific access
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Todos collection
    match /todos/{todoId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && validTodo(request.resource.data);
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.userId
        && validTodoUpdate(request.resource.data);
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.userId;
    }

    function validTodo(todo) {
      return todo.size() >= 5 
        && todo.title is string 
        && todo.title.size() > 0 
        && todo.title.size() <= 100
        && todo.status in ['pending', 'in-progress', 'urgent', 'completed']
        && todo.priority in [0, 1, 2]
        && todo.createdAt is string
        && todo.history is list;
    }

    function validTodoUpdate(todo) {
      return (todo.title is string 
        && todo.title.size() > 0 
        && todo.title.size() <= 100)
        || todo.status in ['pending', 'in-progress', 'urgent', 'completed']
        || todo.priority in [0, 1, 2];
    }
  }
}